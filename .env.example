# Phase 6: validated public application origin; required HTTPS when SQL_ENV=production.
# Set before next build AND next start; local default is http://localhost:3000.
APP_ORIGIN=http://localhost:3000
# Server-side deployment identity. Keep SQL_ENV=production for hosted staging; this is a separate explicit gate.
LAPIS_ENV=production
# Only set true for the disposable exact HTTP staging origin http://lapis-staging.runasp.net.
ALLOW_INSECURE_HTTP_STAGING=false
# These public values are compiled by next.config from APP_ORIGIN; they contain no secrets.
# Changing them or the final hostname requires a fresh build. Real .env remains operator-owned.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQL settings are server-only. No SQL_/secret variable may use NEXT_PUBLIC_.
# Explicit environment: development | test | production. Production writes need reviewed CLI plans.
SQL_ENV=
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
# Small per-process pool; migrations need >=2 connections, default is 3.
SQL_POOL_MAX=3
SQL_CONNECT_TIMEOUT_MS=5000
SQL_REQUEST_TIMEOUT_MS=15000

# All writes default to disabled. Set only for an explicitly dedicated database.
SQL_EXPECT_DATABASE=
SQL_ALLOW_MIGRATIONS=false
SQL_ALLOW_SEED=false
# Integration tests additionally require SQL_ENV=test and lapis_test_<16 hex chars>.
SQL_ALLOW_TESTS=false

# Private absolute persistent media directory outside the running project/deployed app root.
# No fallback; never use public, .next, build output or Git staging. Confirm host ACLs and persistence.
UPLOAD_DIR=

# Internal backend and dashboard sessions. All values below are SERVER-ONLY.
# JSON object: key-id -> independent random base64 key (>=32 bytes each).
AUTH_JWT_KEYS=
AUTH_JWT_ACTIVE_KID=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_TOKEN_TTL_SECONDS=900
# Separate random base64 secret (>=32 bytes). Never reuse a JWT key.
AUTH_OTP_KEY=

# SMTP only; no runtime test-mail toggle. TLS verification is always enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private CLI bootstrap; production additionally requires the production maintenance plan.
AUTH_BOOTSTRAP_ALLOW=false
AUTH_BOOTSTRAP_CONFIRM=
AUTH_BOOTSTRAP_EMAIL=
# Supply only as a temporary process/secret-manager value; never commit a password.
AUTH_BOOTSTRAP_PASSWORD=

# Phase7 clean start: explicit CLI only. Creates neutral settings/inactive ad/canonical roles,
# never users, content or files. Run AFTER migrations and BEFORE first administrator.
SQL_CLEAN_START_CONFIRM=
# To authorize initialization set exactly INITIALIZE_EMPTY_LAPIS (plus SQL_ALLOW_SEED/target).

# Production maintenance process ONLY; leave disabled/empty in the web application.
# Read docs/backend/PHASE7_MIGRATION_BOOTSTRAP.md before setting these.
# Plan command is read-only; apply rechecks operation, target, catalog, history and plan under SQL lock.
SQL_MAINTENANCE_ALLOW=false
# migrate | initialize | bootstrap
SQL_MAINTENANCE_OPERATION=
# Private absolute file outside checkout; exclusive creation; expires after 30 minutes.
SQL_MAINTENANCE_PLAN_FILE=
SQL_MAINTENANCE_PLAN_SHA256=
# Exact APPLY:<operation>:<database name>
SQL_MAINTENANCE_CONFIRM=
# Existing database writes require a reviewed backup receipt (operator attestation).
SQL_MAINTENANCE_BACKUP_FILE=

# Private nonproduction recovery CLI only; default is a read-only audit, at most 100 metadata rows.
STORAGE_RECOVERY_REPAIR=false
STORAGE_RECOVERY_CONFIRM=
STORAGE_RECOVERY_AFTER_ID=0

# HISTORICAL OPTIONAL TOOLS ONLY: NOT a clean-start release requirement. Do not run for Phase7.
# Explicit private read-only import/inventory commands; never startup jobs.
# Absolute operator-supplied export/report files, outside this checkout. Reports use exclusive creation.
DATA_IMPORT_SOURCE=
DATA_IMPORT_REPORT=
DATA_INVENTORY_REPORT=
